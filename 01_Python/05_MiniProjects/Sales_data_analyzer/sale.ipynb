   "source": [
    "class Sale:\n",
    "    def __init__(self, sale_id, product, quantity, price):\n",
    "        self.sale_id = int(sale_id)\n",
    "        self.product = product\n",
    "        self.quantity = int(quantity)\n",
    "        self.price = float(price)\n",
    "\n",
    "    def total_price(self):\n",
    "        return self.quantity * self.price\n"
   ]
  }
